# ==============================================================================
# LiveDrop Seller Mobile App — Environment Variables Contract (.env.example)
# ==============================================================================
#
# RULE: NEVER commit actual secret values, service-role keys, or production keys.
# Copy this file to '.env' for local development or pass via '--dart-define'.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Mobile Client Surface)
# ------------------------------------------------------------------------------

# Variable: SUPABASE_URL
# Purpose: The HTTPS endpoint of the Supabase project.
# Classification: PUBLIC (Embedded in mobile client configuration)
# Used By: Supabase client initialization in lib/core/services/supabase_service.dart
SUPABASE_URL=https://your-project-id.supabase.co

# Variable: SUPABASE_ANON_KEY
# Purpose: The public anonymous API key for Supabase PostgREST & Auth.
# Classification: PUBLIC (Protected by PostgreSQL Row-Level Security)
# Used By: Supabase client for seller email/password auth and session token exchange
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------

# Variable: APP_ENV
# Purpose: Declares runtime environment ('development', 'staging', 'production').
# Classification: PUBLIC
APP_ENV=development
