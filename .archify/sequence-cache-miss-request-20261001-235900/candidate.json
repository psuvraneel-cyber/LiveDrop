    {
      "dot": "emerald",
      "title": "Cache-Aside Pattern",
      "items": [
        "Browser issues GET request to API service",
        "API queries Redis in-memory cache first for fast response",
        "Sub-millisecond latency when key already exists"
      ]
    },
    {
      "dot": "rose",
      "title": "Cache Miss Handling",
      "items": [
        "Redis returns nil indicating the item is not currently cached",
        "API falls back to PostgreSQL primary database",
        "Queries authoritative store by ID to retrieve fresh record"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache Warming & Delivery",
      "items": [
        "API fills Redis cache with retrieved data and TTL (EX 3600)",
        "Subsequent requests will hit cache directly",
        "API completes lifecycle by returning 200 OK JSON to Browser"
      ]
    }
