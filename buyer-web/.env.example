# ==============================================================================
# LiveDrop Buyer Webfront — Environment Variables Contract (.env.example)
# ==============================================================================
#
# RULE: NEVER commit actual secret values, service-role keys, or production keys.
# Copy this file to '.env.local' for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Public Surface)
# ------------------------------------------------------------------------------

# Variable: NEXT_PUBLIC_SUPABASE_URL
# Purpose: The HTTPS endpoint of the Supabase project / REST gateway.
# Classification: PUBLIC (Safe to expose in browser bundle)
# Used By: Browser Supabase client (src/lib/supabase/client.ts) and Edge SSR (src/lib/supabase/server.ts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Variable: NEXT_PUBLIC_SUPABASE_ANON_KEY
# Purpose: The public anonymous API key for Supabase PostgREST & Realtime.
# Classification: PUBLIC (Protected by PostgreSQL Row-Level Security)
# Used By: Browser Supabase client for reading active drops and executing public RPCs
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# APPLICATION METADATA & TELEMETRY
# ------------------------------------------------------------------------------

# Variable: NEXT_PUBLIC_APP_ENV
# Purpose: Declares current runtime environment ('development', 'staging', 'production').
# Classification: PUBLIC
NEXT_PUBLIC_APP_ENV=development

# Variable: NEXT_PUBLIC_APP_BASE_URL
# Purpose: Canonical base URL for constructing OpenGraph preview links and WhatsApp deep links.
# Classification: PUBLIC
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
